        "jsonSchemaExample": "{\"operations\":[{\"direction\":\"Списание\",\"date\":\"02.10.2026\",\"amount\":10500,\"payment\":\"Сбер\",\"article\":\"топливо\",\"project\":\"\",\"counterparty\":\"\",\"purpose\":\"доставка материалов\",\"check\":\"\"}]}"
      },
