      "id": "de72911a-7e03-430a-9eb4-b6b7f5b0c308",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "let text = $input.first().json.data || '';\nconst fromDate = $('Форма').first().json.from || '';\ntext = text.replace(/[\\u200e\\u200f\\u202a-\\u202e\\u2068\\u2069]/g, '');\nconst re = /^\\[?(\\d{1,2})[./](\\d{1,2})[./](\\d{2,4}),?\\s+(\\d{1,2}:\\d{2})(?::\\d{2})?\\]?\\s*[-–]?\\s*(.*)$/;\nconst msgs = [];\nfor (const line of text.split(/\\r?\\n/)) {\n  const m = line.match(re);\n  if (m) {\n    let [, d, mo, y, time, rest] = m;\n    if (y.length === 2) y = '20' + y;\n    const i = rest.indexOf(': ');\n    if (i === -1) { msgs.push(null); continue; }\n    msgs.push({ d: d.padStart(2,'0'), mo: mo.padStart(2,'0'), y, time,\n                author: rest.slice(0, i).trim(), text: rest.slice(i + 2) });\n  } else if (msgs.length && msgs[msgs.length - 1]) {\n    msgs[msgs.length - 1].text += '\\n' + line;\n  }\n}\nconst hash = s => { let h = 5381; for (const c of s) h = ((h << 5) + h + c.charCodeAt(0)) >>> 0; return h.toString(36); };\nreturn msgs.filter(Boolean)\n  .map(x => ({ ...x, text: x.text.replace(/<Сообщение изменено>|<Без медиафайлов>/gi, '').trim() }))\n  .filter(x => x.text && /\\d/.test(x.text) && !/^Данное сообщение удалено/i.test(x.text))\n  .filter(x => !fromDate || `${x.y}-${x.mo}-${x.d}` >= fromDate)\n  .map(x => ({ json: {\n    id: `${x.y}${x.mo}${x.d}-${x.time}-${hash(x.author + x.text)}`,\n    date: `${x.d}.${x.mo}.${x.y}`, time: x.time, author: x.author, text: x.text\n  }}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        0
      ],
      "id": "e193f897-fcb3-40c8-9053-25101fd4ad44",
      "name": "Разбор"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты — бухгалтер. Разбери сообщение из рабочей WhatsApp-группы учёта денег.\nАвтор: {{ $json.author }}\nДата сообщения: {{ $json.date }}\nТекст: \"\"\"{{ $json.text }}\"\"\"\n\nВерни массив operations — по одной записи на каждую денежную операцию в сообщении.\nЕсли операций нет (обсуждение, вопрос, остатки по счетам) — верни пустой массив.\n\nПоля каждой операции:\n- direction: \"Списание\" для «Расход…»; \"Поступление\" для «Внес на…», «Приход…»\n- date: дата операции ДД.ММ.ГГГГ. Если в тексте явно указана другая дата операции — её, иначе дату сообщения.\n- amount: сумма в рублях, положительное число. ВАЖНО: точка перед ровно тремя цифрами — разделитель тысяч (\"11.000₽\" = 11000, \"1.054.000\" = 1054000); две цифры после точки — копейки (\"19 657.14\" = 19657.14). Знаки ₽, р, ! убрать.\n- payment: \"Сбер\", \"Альфа\" или \"Наличные\" (наличка, налом). Если счёт не указан — пустая строка.\n- article: статья. Выбирай из списка: общие расходы, топливо, аванс, кредит, инвестор, зарплата, возврат зарплаты, доставка. Если не подходит ни одна — напиши своими словами и заполни check.\n- project: проект, если упомянут («проект №1», «проект А»), иначе пусто.\n- counterparty: кому заплатили или от кого пришли деньги (имя, компания), иначе пусто.\n- purpose: назначение — остальные детали коротко.\n- check: пусто, если всё однозначно. Иначе коротко причина: «не указан счёт», «неясная сумма», «исправление/опечатка», «возможны разные трактовки».",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -32,
