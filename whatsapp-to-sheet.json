    {
      "parameters": {
        "jsCode": "const out = [];\n$input.all().forEach((item, i) => {\n  const src = $('Разбор').itemMatching(i).json;\n  const ops = (item.json.output && item.json.output.operations) || [];\n  ops.forEach((op, k) => out.push({ json: {\n    ...op, id: `${src.id}-${k}`, author: src.author, text: src.text\n  }}));\n});\nreturn out;"
      },
